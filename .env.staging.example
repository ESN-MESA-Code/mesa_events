# MESA Events Platform – STAGING configuration (docs/STAGING.md). Copy to
# .env.staging (never commit it) for docker-compose.staging.yml, or enter the
# same values in the staging Vercel project. Test data only: the staging
# Supabase project must never be the production one.

# ── The app environment: both say staging ─────────────────────────────────────
# NEXT_PUBLIC_APP_ENV is baked in at build time (a build arg / Vercel build env);
# APP_ENV is read at runtime. The server refuses to start if they disagree.
NEXT_PUBLIC_APP_ENV=staging
APP_ENV=staging

# ── The staging Supabase project (Settings → API) ─────────────────────────────
NEXT_PUBLIC_SUPABASE_URL=https://your-staging-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-staging-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-staging-service-role-key
# The gates (lib/staging.ts): the ref of NEXT_PUBLIC_SUPABASE_URL must equal
# STAGING_SUPABASE_PROJECT_REF and differ from PRODUCTION_SUPABASE_PROJECT_REF.
# Hosted: the subdomain (https://<ref>.supabase.co). Self-hosted: host[:port]
# of the URL, e.g. supabase.staging.example.org.
STAGING_SUPABASE_PROJECT_REF=your-staging-ref
PRODUCTION_SUPABASE_PROJECT_REF=your-production-ref

# ── The demo sign-in ──────────────────────────────────────────────────────────
# Shared with the presenters; at least 16 characters (e.g. `openssl rand -base64 18`).
# Changing it signs everyone out of the role picker.
STAGING_ACCESS_CODE=

# ── The app ──────────────────────────────────────────────────────────────────
APP_BASE_URL=https://staging.events.esnmesa.org
NEXT_PUBLIC_GOOGLE_WORKSPACE_DOMAIN=esnmesa.org
# At least 32 characters; the same value goes into private.config (docs/STAGING.md).
JOBS_SECRET=

# ── External services: fakes only ─────────────────────────────────────────────
# The server refuses to start on staging with any of the real credentials set
# (GOOGLE_SERVICE_ACCOUNT_EMAIL, GOOGLE_SERVICE_ACCOUNT_KEY, TELEGRAM_BOT_TOKEN)
# or a Google mode other than fake. Chat, Drive, Directory and Telegram are
# recorded in the database; Admin → "Demo outbox" shows them.
GOOGLE_MODE=fake
TELEGRAM_MODE=fake

# Optional: role groups. On staging the demo teams come from the seed; the fake
# directory mirrors them, so the daily role sync keeps them.
GROUP_EVENTS=events@esnmesa.org
GROUP_COMMS=comms@esnmesa.org
GROUP_FINANCE=finance@esnmesa.org
GROUP_TREASURER=treasurer@esnmesa.org
GROUP_EXECUTIVES=board@esnmesa.org
GROUP_ADMINS=it@esnmesa.org
