# MESA Events Platform – configuration. Copy to .env.local (never commit it).
# Locally you need none of this: `npm run dev:local` uses the local Supabase
# stack's demo keys (scripts/local-supabase.mjs).

# ── Supabase (Settings → API, or your self-hosted stack) ─────────────────────
# NEXT_PUBLIC_* values are baked into the browser bundle at build time
# (pass them as build args to `docker build`, see Dockerfile).
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
# Server only (jobs runner, role sync). Never NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# ── The app ──────────────────────────────────────────────────────────────────
# Public base URL on your own domain (links in Chat messages, HSTS when https).
APP_BASE_URL=https://events.esnmesa.org
# Google Workspace domain allowed to sign in. Keep in step with
# private.config 'workspace_domain' in the database (default esnmesa.org).
NEXT_PUBLIC_GOOGLE_WORKSPACE_DOMAIN=esnmesa.org

# ── Background jobs ──────────────────────────────────────────────────────────
# Shared secret of POST /api/jobs/run (at least 32 characters). pg_cron sends
# it; store the same value in the database:
#   insert into private.config values ('job_runner_url', 'https://events.esnmesa.org/api/jobs/run'),
#                                     ('job_runner_secret', '<JOBS_SECRET>')
#   on conflict (key) do update set value = excluded.value;
JOBS_SECRET=

# ── Roles: Google Workspace groups (addresses are configuration) ──────────────
GROUP_EVENTS=events@esnmesa.org
GROUP_COMMS=comms@esnmesa.org
GROUP_FINANCE=finance@esnmesa.org
GROUP_TREASURER=treasurer@esnmesa.org
GROUP_EXECUTIVES=board@esnmesa.org
# HR and the Vice President plan internal events, meetings and office hours.
GROUP_HR=hr@esnmesa.org
GROUP_VICE_PRESIDENT=vicepresident@esnmesa.org
# Newbies of the semester: their own leaderboard on Home.
GROUP_NEWBIES=newbies@esnmesa.org
GROUP_ADMINS=it@esnmesa.org

# ── Google APIs (service account). Without them the app uses fakes. ───────────
# "fake" forces the database-backed fakes, "real" requires the service account.
GOOGLE_MODE=
GOOGLE_SERVICE_ACCOUNT_EMAIL=events-platform@your-project.iam.gserviceaccount.com
GOOGLE_SERVICE_ACCOUNT_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"
# Directory API with domain-wide delegation: a Workspace admin to impersonate
GOOGLE_ADMIN_SUBJECT=
# Chat API acts as this Workspace user (domain-wide delegation, Chat scopes)
GOOGLE_CHAT_SUBJECT=events-bot@esnmesa.org
# Drive: the photo drive's root folder (as the bot's PHOTOS_FOLDER_ID, e.g.
# "MESA - Photos › Public Events"). The platform creates <semester>/<yyyy-MM-dd
# Event> below it and counts the files the team uploads there. It must be in a
# SHARED DRIVE that the members can already open (they upload with their own
# accounts; no per-file sharing). The service account – or GOOGLE_DRIVE_SUBJECT,
# a Workspace user it impersonates – needs to be a member (Content manager) of
# that shared drive; the scope is https://www.googleapis.com/auth/drive.
DRIVE_PHOTOS_FOLDER_ID=
GOOGLE_DRIVE_SUBJECT=

# ── Telegram (publishing schedule). Without a token the fake is used. ─────────
# Bot token from @BotFather; the bot must be an admin of the channel/group.
TELEGRAM_BOT_TOKEN=
# @channelname or the numeric id (-100…)
TELEGRAM_CHAT_ID=
# Optional forum topic of a group
TELEGRAM_TOPIC_ID=
# "fake" keeps Telegram on the fake even with a token (e.g. a test server)
TELEGRAM_MODE=

# ── Address lookup (event addresses: suggestions and verification) ───────────
# photon | fake | off. Unset = photon in production builds, fake otherwise;
# staging always uses the fake. Called from the server only (/api/address).
ADDRESS_LOOKUP=
# A Photon instance (OpenStreetMap). The public one has a fair-use policy;
# self-host for heavy use. Default: https://photon.komoot.io
PHOTON_URL=

# ── App environment ──────────────────────────────────────────────────────────
# production | staging | development. NEXT_PUBLIC_APP_ENV is baked in at build
# time (unset = production in builds); APP_ENV is read at runtime. Both say
# "staging" on a staging deployment (docs/STAGING.md, .env.staging.example).
APP_ENV=production
NEXT_PUBLIC_APP_ENV=production
# The production project's ref (https://<ref>.supabase.co). Set it on staging
# too: the demo sign-in and the demo data reset refuse to run against it.
PRODUCTION_SUPABASE_PROJECT_REF=
# Staging only – see .env.staging.example:
# STAGING_SUPABASE_PROJECT_REF=   the staging project's ref (host:port when self-hosted)
# STAGING_ACCESS_CODE=            shared code in front of the demo sign-in (16+ characters)

# ── pretix (optional) ────────────────────────────────────────────────────────
# Finance → Import → "Fetch from pretix" reads the orders of every event whose
# pretix page Comms linked. Without these, Finance imports the CSV export.
# A token of a pretix team that may view orders (organizer → Teams → API tokens).
PRETIX_ORGANIZER=
PRETIX_API_TOKEN=
# Only when pretix is not pretix.eu (self-hosted):
# PRETIX_URL=https://pretix.example.org

# ── Local development only (ignored in production builds) ────────────────────
NEXT_PUBLIC_LOCAL_LOGIN=
